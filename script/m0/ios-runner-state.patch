+  // XCUIApplication.state is a passively updated, asynchronous observation.
+  // This is NOT an atomic OS foreground oracle. The caller waits for two
+  // stable samples and fails closed on unknown states or elapsed deadlines.
+  private func executeLoopitAppStates(command: Command) -> Response {
+    guard let nonce = command.commandId, !nonce.isEmpty, nonce.count <= 128,
+          let ids = command.queryBundleIds, !ids.isEmpty, ids.count <= 8,
+          Set(ids).count == ids.count,
+          ids.allSatisfy({ $0.range(of: "^[A-Za-z0-9][A-Za-z0-9.-]{1,254}$", options: .regularExpression) != nil }),
+          let udid = ProcessInfo.processInfo.environment["SIMULATOR_UDID"], !udid.isEmpty else {
+      return Response(ok: false, error: ErrorPayload(
+        code: "INVALID_ARGS", message: "state observation requires a nonce, simulator identity and 1-8 unique bundle ids"))
+    }
+    let started = currentUptimeMs()
+    let names = ["unknown", "not_running", "background_suspended", "background", "foreground"]
+    let entries = ids.map { bundleId -> LoopitAppStateEntry in
+      // Construct a proxy and read its state. NEVER launch, activate, terminate,
+      // waitForExistence, resolve the cached target, or capture an AX tree here.
+      let raw = XCUIApplication(bundleIdentifier: bundleId).state.rawValue
+      return LoopitAppStateEntry(bundleId: bundleId, rawState: raw,
+        state: raw < UInt(names.count) ? names[Int(raw)] : "unknown")
+    }
+    NSLog("LOOPIT_APP_STATES nonce=%@ states=%@", nonce,
+      entries.map { "\($0.bundleId)=\($0.rawState)" }.joined(separator: ","))
+    return Response(ok: true, data: DataPayload(loopitAppStates: LoopitAppStateObservation(
+      schemaVersion: "loopit-ios-state/1", nonce: nonce, deviceUdid: udid,
+      startedUptimeMs: started, finishedUptimeMs: currentUptimeMs(), entries: entries)))
   }
 
