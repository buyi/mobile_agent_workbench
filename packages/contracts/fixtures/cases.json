{
  "dataset": "contract-core/1",
  "description": "M0-A01 / S12 contract fixtures. Each case patches a valid baseline from valid/ and states the expected outcome. Patch ops: set, delete, push.",
  "cases": [
    { "id": "goal-valid", "fixture": "goal", "expect": "ok" },
    { "id": "goal-frozen", "fixture": "goal", "check": "frozen", "expect": "ok" },
    { "id": "goal-missing-objective", "fixture": "goal", "patch": [["delete", "objective"]], "expect": "schema_invalid" },
    { "id": "goal-unknown-version", "fixture": "goal", "patch": [["set", "schemaVersion", "goal/2"]], "expect": "incompatible_schema_version" },
    { "id": "goal-no-version", "fixture": "goal", "patch": [["delete", "schemaVersion"]], "expect": "schema_version_missing" },
    { "id": "goal-unknown-kind", "fixture": "goal", "patch": [["set", "schemaVersion", "wish/1"]], "expect": "unknown_contract" },
    { "id": "goal-empty-acceptance", "fixture": "goal", "patch": [["set", "acceptance", []]], "expect": "schema_invalid" },
    { "id": "goal-bad-stage", "fixture": "goal", "patch": [["set", "acceptance.0.requiredAtStage", "shipping"]], "expect": "schema_invalid" },
    { "id": "goal-duplicate-criterion", "fixture": "goal", "patch": [["set", "acceptance.1.id", "F1"], ["delete", "acceptance.1.dependsOn"]], "expect": "acceptance_duplicate_id" },
    { "id": "goal-unknown-dependency", "fixture": "goal", "patch": [["set", "acceptance.1.dependsOn", ["F9"]]], "expect": "acceptance_dependency_unknown" },
    { "id": "goal-dependency-cycle", "fixture": "goal", "patch": [["set", "acceptance.0.dependsOn", ["F2"]]], "expect": "acceptance_dependency_cycle" },
    { "id": "goal-dependency-future-stage", "fixture": "goal", "patch": [["set", "acceptance.0.dependsOn", ["D1"]]], "expect": "acceptance_dependency_future_stage" },
    { "id": "goal-semantic-without-rubric", "fixture": "goal", "patch": [["delete", "acceptance.2.rubricRef"]], "expect": "acceptance_rubric_missing" },
    { "id": "goal-measured-without-threshold", "fixture": "goal", "patch": [["delete", "acceptance.3.threshold"]], "expect": "acceptance_threshold_missing" },
    { "id": "goal-placeholder-not-frozen", "fixture": "goal", "check": "frozen", "patch": [["set", "scope.allowedPaths", ["<confirmed-feature-scope>"]]], "expect": "placeholder" },
    { "id": "goal-branch-base-not-frozen", "fixture": "goal", "check": "frozen", "patch": [["set", "scope.baseRevision", "main"]], "expect": "unpinned" },
    { "id": "goal-unpinned-policy-not-frozen", "fixture": "goal", "check": "frozen", "patch": [["set", "policyRef", "policy://loopit-internal/v1"]], "expect": "unpinned" },
    { "id": "goal-unpinned-policy-still-parses", "fixture": "goal", "patch": [["set", "policyRef", "policy://loopit-internal/v1"]], "expect": "ok" },

    { "id": "policy-valid", "fixture": "policy", "expect": "ok" },
    { "id": "policy-bad-digest", "fixture": "policy", "patch": [["set", "digest", "sha256:xyz"]], "expect": "schema_invalid" },
    { "id": "context-valid", "fixture": "context", "expect": "ok" },
    { "id": "context-bad-config-kind", "fixture": "context", "patch": [["set", "effectiveConfig.0.kind", "global-home"]], "expect": "schema_invalid" },
    { "id": "execution-valid", "fixture": "execution", "expect": "ok" },
    { "id": "execution-missing-context", "fixture": "execution", "patch": [["delete", "contextManifest"]], "expect": "schema_invalid" },
    { "id": "capabilities-valid", "fixture": "runtime-capabilities", "expect": "ok" },
    { "id": "capabilities-bad-status", "fixture": "runtime-capabilities", "patch": [["set", "checkpoint.status", "probably"]], "expect": "schema_invalid" },

    { "id": "plan-valid", "fixture": "plan", "expect": "ok" },
    { "id": "plan-cycle", "fixture": "plan", "patch": [["push", "nodes.0.requiredInputs", "observation-report"], ["push", "edges", { "from": "n-operations", "to": "n-requirements", "artifactKind": "observation-report" }]], "expect": "plan_cycle" },
    { "id": "plan-edge-type-mismatch", "fixture": "plan", "patch": [["set", "edges.0.artifactKind", "release-manifest"]], "expect": "plan_edge_type_mismatch" },
    { "id": "plan-unsatisfied-input", "fixture": "plan", "patch": [["delete", "edges.2"]], "expect": "plan_input_unsatisfied" },
    { "id": "plan-over-budget", "fixture": "plan", "patch": [["set", "budgetMinutes", 30]], "expect": "plan_budget_exceeded" },
    { "id": "plan-unknown-node", "fixture": "plan", "patch": [["set", "edges.0.to", "n-ghost"]], "expect": "plan_edge_unknown_node" },

    { "id": "stage-result-valid", "fixture": "stage-result", "expect": "ok" },
    { "id": "stage-result-skip-without-disposition", "fixture": "stage-result", "patch": [["delete", "disposition"]], "expect": "disposition_missing" },
    { "id": "stage-result-reuse-without-artifacts", "fixture": "stage-result", "patch": [["set", "status", "reused"], ["set", "disposition.mode", "reused"]], "expect": "reuse_without_artifacts" },
    { "id": "stage-result-failed-without-failure", "fixture": "stage-result", "patch": [["set", "status", "failed"], ["delete", "disposition"]], "expect": "failure_missing" },

    { "id": "artifact-valid", "fixture": "artifact", "expect": "ok" },
    { "id": "artifact-negative-size", "fixture": "artifact", "patch": [["set", "size", -1]], "expect": "schema_invalid" },
    { "id": "evidence-valid", "fixture": "evidence", "expect": "ok" },
    { "id": "evidence-no-criteria", "fixture": "evidence", "patch": [["set", "criterionIds", []]], "expect": "schema_invalid" },

    { "id": "gate-valid", "fixture": "gate", "expect": "ok" },
    { "id": "gate-valid-against-goal", "fixture": "gate", "check": "gate", "expect": "ok" },
    { "id": "gate-future-criterion-judged", "fixture": "gate", "check": "gate", "patch": [["set", "results.4", { "criterionId": "D1", "outcome": "passed", "evidenceRefs": ["evidence://ev-9"] }]], "expect": "gate_future_criterion" },
    { "id": "gate-pass-without-evidence", "fixture": "gate", "check": "gate", "patch": [["set", "results.0.evidenceRefs", []]], "expect": "gate_pass_without_evidence" },
    { "id": "gate-missing-criterion", "fixture": "gate", "check": "gate", "patch": [["delete", "results.3"]], "expect": "gate_criteria_unaccounted" },
    { "id": "gate-passed-with-uncovered", "fixture": "gate", "check": "gate", "patch": [["delete", "results.3"], ["set", "uncovered", ["F7"]]], "expect": "gate_verdict_inconsistent" },
    { "id": "gate-passed-with-failure", "fixture": "gate", "check": "gate", "patch": [["set", "results.1", { "criterionId": "F2", "outcome": "failed", "failureCode": "build_mismatch", "evidenceRefs": ["evidence://ev-002"] }]], "expect": "gate_verdict_inconsistent" },
    { "id": "gate-stage-scope-without-stage", "fixture": "gate", "check": "gate", "patch": [["delete", "stage"]], "expect": "gate_stage_missing" },

    { "id": "event-valid", "fixture": "event", "expect": "ok" },
    { "id": "event-negative-version", "fixture": "event", "patch": [["set", "aggregateVersion", -1]], "expect": "schema_invalid" },
    { "id": "operation-valid", "fixture": "operation", "expect": "ok" },
    { "id": "operation-bad-state", "fixture": "operation", "patch": [["set", "state", "probably_done"]], "expect": "schema_invalid" },

    { "id": "milestone-valid-blocked", "fixture": "milestone", "expect": "ok" },
    { "id": "milestone-notrun-claims-passed", "fixture": "milestone", "patch": [["set", "verdict", "passed"]], "expect": "milestone_verdict_inconsistent" },
    { "id": "milestone-builder-issuer", "fixture": "milestone", "patch": [["set", "issuer.kind", "builder"]], "expect": "milestone_untrusted_issuer" },
    { "id": "milestone-m1-without-upstream", "fixture": "milestone", "patch": [["set", "milestone", "M1"]], "expect": "milestone_upstream_missing" },

    { "id": "command-valid", "fixture": "command", "expect": "ok" },
    { "id": "command-unknown-type", "fixture": "command", "patch": [["set", "type", "deleteEverything"]], "expect": "schema_invalid" },
    { "id": "command-missing-expected-version", "fixture": "command", "patch": [["delete", "expectedVersion"]], "expect": "schema_invalid" },
    { "id": "command-invalid-goal", "fixture": "command", "patch": [["delete", "goal.acceptance"]], "expect": "schema_invalid" },
    { "id": "receipt-valid", "fixture": "receipt", "expect": "ok" },
    { "id": "receipt-bad-status", "fixture": "receipt", "patch": [["set", "status", "maybe"]], "expect": "schema_invalid" }
  ]
}
